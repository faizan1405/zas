# ══════════════════════════════════════════════════════════════════
# .env.example — copy to .env and fill in real values.
#   cp .env.example .env
# These are every environment variable configured on the Vercel
# project "zas". System-injected vars (VERCEL_*, TURBO_*, NX_DAEMON,
# VERCEL_OIDC_TOKEN) are provided automatically by Vercel and are
# intentionally omitted here.
# ══════════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ─────────────────────────────────────────
# MongoDB Atlas SRV connection string, or local: mongodb://127.0.0.1:27017/zassports
MONGODB_URI=

# ── Auth (recommended) ──────────────────────────────────────────
# High-entropy secret, e.g. crypto.randomBytes(48).base64url
JWT_SECRET=

# ── Admin seed account (optional) ───────────────────────────────
# Used by POST /api/admin/seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cloudinary ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth (login via Google) ─────────────────────────────
# Authorized redirect URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App URLs ────────────────────────────────────────────────────
# Base URL of the site (dev: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
# Canonical production URL (used for OAuth redirects, SEO)
NEXT_PUBLIC_CANONICAL_URL=
# Admin panel paths (repo routes: /admin and /admin/login)
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_ADMIN_LOGIN_URL=

# ── Social Links ─────────────────────────────────────────────────
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── WhatsApp ─────────────────────────────────────────────────────
# Full number with country code, no dashes (e.g. 918860654659)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Razorpay (payments) ─────────────────────────────────────────
# From Razorpay Dashboard > Settings > API Keys (test: rzp_test_… / live: rzp_live_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
